# IMPORTANT: COPY THIS FILE TO .env AND CHANGE ALL VALUES FOR PRODUCTION USE
# ---------------------------------------------------

# PostgreSQL Connection
POSTGRES_USER=infrapilot
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=infrapilot_db

# Backend config
# Native backend + docker-compose.db.yml uses localhost port 5435.
# Full Docker Compose overrides this URL inside the backend container.
DATABASE_URL=postgresql://infrapilot:your_secure_password@localhost:5435/infrapilot_db?schema=public
JWT_SECRET=your_long_random_jwt_secret
CREDENTIAL_ENCRYPTION_KEY=64_character_hex_key_for_aes_256_encryption
DEFAULT_ADMIN_PASSWORD=your_admin_password
DEFAULT_EDITOR_PASSWORD=your_editor_password
DEFAULT_VIEWER_PASSWORD=your_viewer_password
REGISTRATION_SECRET=your_registration_secret_key
FRONTEND_URL=http://localhost:3000
COOKIE_SECURE=false
ALLOW_DEVELOPMENT_SEED=false
# Comma-separated vCenter DNS names permitted for connection/sync in production.
VCENTER_ALLOWED_HOSTS=vcenter.example.internal
# Development only: set true to use the built-in mock adapter for known mock hosts.
# Keep false (or unset) to require a real vCenter connection. Never enable in production.
VCENTER_MOCK_ENABLED=false

# Frontend config
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# PgAdmin config
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=your_pgadmin_password
