// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
  VIEWER
}

enum AssetType {
  SERVER
  STORAGE
  SWITCH
  SP
  NETWORK
}

enum AssetStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
  DECOMMISSIONED
  ARCHIVED
}

enum VmPowerState {
  RUNNING
  STOPPED
  SUSPENDED
}

enum VmEnvironment {
  PROD
  TEST
  UAT
}

enum VmDiscoveryState {
  NEEDS_CONTEXT
  READY_TO_PROMOTE
  DRIFTED
  ARCHIVED
}

enum VmLifecycleState {
  DRAFT
  ACTIVE
  DELETED_IN_VCENTER
  ARCHIVED
}

enum VmCriticality {
  MISSION_CRITICAL
  BUSINESS_CRITICAL
  STANDARD
}

enum DatabaseStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
  ARCHIVED
}

enum ApplicationStatus {
  ACTIVE
  ARCHIVED
}

enum ApplicationEnvironmentName {
  PROD
  UAT
  TEST
}

enum VmSourceStatus {
  READY_TO_SYNC
  HEALTHY
  CONNECTION_FAILED
  ARCHIVED
}

enum AuditAction {
  VIEW_PASSWORD
  COPY_PASSWORD
  LOGIN
  LOGIN_FAILED
  CREATE_USER
  UPDATE_USER_ROLE
  RESET_USER_PASSWORD
  CHANGE_OWN_PASSWORD
  CREATE_ASSET
  UPDATE_ASSET
  DELETE_ASSET
  CREATE_CREDENTIAL
  UPDATE_CREDENTIAL
  CREATE_DATABASE
  UPDATE_DATABASE
  DELETE_DATABASE
  CREATE_APPLICATION
  UPDATE_APPLICATION
  ARCHIVE_APPLICATION
  RESTORE_APPLICATION
  VIEW_APPLICATION_PASSWORD
  COPY_APPLICATION_PASSWORD
  CREATE_VM
  UPDATE_VM
  DELETE_VM
  VCENTER_SYNC
  CREATE_SOURCE
  DELETE_SOURCE
  UPDATE_SOURCE
  EXPORT_DATA
  DELETE_CREDENTIAL
  DELETE_USER
  CREATE_ASSET_NOTE
  UPDATE_ASSET_NOTE
  DELETE_ASSET_NOTE
  UPLOAD_ASSET_ATTACHMENT
  DELETE_ASSET_ATTACHMENT
  DOWNLOAD_ASSET_ATTACHMENT
  CREATE_KB_CATEGORY
  DELETE_KB_CATEGORY
  CREATE_KB_DOCUMENT
  UPDATE_KB_DOCUMENT
  DELETE_KB_DOCUMENT
  UPLOAD_KB_IMAGE
}

model User {
  id                 String    @id @default(uuid())
  username           String    @unique
  displayName        String
  avatarSeed         String
  avatarImage        String?
  email              String?   @unique
  passwordHash       String
  mustChangePassword Boolean   @default(false)
  role               Role      @default(VIEWER)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  assets              Asset[]
  databaseInventories DatabaseInventory[]
  vmVCenterSources    VmVCenterSource[]
  vmDiscoveries       VmDiscovery[]
  vmInventories       VmInventory[]
  auditLogs           AuditLog[]
  assetNotes          AssetNote[]
  assetAttachments    AssetAttachment[]

  writtenDocuments KnowledgeDocument[]
  applications     Application[]
}

model Application {
  id              String                         @id @default(uuid())
  name            String                         @unique
  technicalOwner  String?
  businessUnit    String?
  description     String?
  status          ApplicationStatus              @default(ACTIVE)
  createdByUserId String
  createdByUser   User                           @relation(fields: [createdByUserId], references: [id])
  environments    ApplicationEnvironment[]
  access          ApplicationAccess[]
  documentLinks   KnowledgeDocumentApplication[]
  createdAt       DateTime                       @default(now())
  updatedAt       DateTime                       @updatedAt

  @@index([status])
  @@index([technicalOwner])
  @@index([businessUnit])
}

model ApplicationEnvironment {
  id            String                     @id @default(uuid())
  applicationId String
  application   Application                @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  name          ApplicationEnvironmentName
  noDatabase    Boolean                    @default(false)
  sortOrder     Int                        @default(0)
  components    ApplicationComponent[]
  access        ApplicationAccess[]
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt

  @@unique([applicationId, name])
  @@index([applicationId, sortOrder])
}

model ApplicationComponent {
  id               String                      @id @default(uuid())
  environmentId    String
  environment      ApplicationEnvironment      @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  name             String
  description      String?
  sortOrder        Int                         @default(0)
  logicalDatabases LogicalDatabase[]
  assetLinks       ApplicationComponentAsset[]
  vmLinks          ApplicationComponentVm[]
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt

  @@unique([environmentId, name])
  @@index([environmentId, sortOrder])
}

model ApplicationAccess {
  id            String                  @id @default(uuid())
  applicationId String?
  application   Application?            @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  environmentId String?
  environment   ApplicationEnvironment? @relation(fields: [environmentId], references: [id], onDelete: SetNull)
  label         String
  address       String
  method        String
  credentials   ApplicationCredential[]
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@index([applicationId])
  @@index([environmentId])
}

model ApplicationCredential {
  id                String            @id @default(uuid())
  accessId          String
  access            ApplicationAccess @relation(fields: [accessId], references: [id], onDelete: Cascade)
  username          String
  encryptedPassword String
  role              String?
  lastChangedDate   DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([accessId])
}

model IPAllocation {
  id           String      @id @default(uuid())
  address      String // e.g. 192.168.1.50
  type         String? // e.g. Management, VIP, Backup, Data, IPMI, Host, Service Processor
  nodeLabel    String?
  manageType   String? // e.g. WEB, SSH, API
  version      String? // e.g. iLO 2.81, ESXi 8.0.3
  assetId      String
  asset        Asset       @relation(fields: [assetId], references: [id], onDelete: Cascade)
  credentialId String?
  credential   Credential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([address, assetId])
  @@index([credentialId])
}

model Asset {
  id               String                      @id @default(uuid())
  assetId          String?                     @unique // e.g., '6303-0003'
  name             String
  type             AssetType
  environment      String? // e.g., 'PROD', 'UAT', 'DEV'
  location         String? // e.g., 'DC'
  rack             String? // e.g., '1C-04'
  osVersion        String? // e.g., 'Fabric OS: v8.2.1c'
  manageType       String? // e.g., 'WEB/SSH'
  brandModel       String? // e.g., 'HPE StoreFabric SN3600B'
  sn               String? // Serial Number
  customMetadata   Json? // Flexible JSON structure for other specs
  status           AssetStatus                 @default(ACTIVE)
  responsibleParty String?
  componentLinks   ApplicationComponentAsset[]
  hostedDatabases  DatabaseInventory[]         @relation("DatabaseHostAsset")
  documentLinks    KnowledgeDocumentAsset[]

  // Financial & Info
  owner              String?
  department         String?
  purchaseDate       DateTime?
  warrantyExpiration DateTime?
  vendor             String?
  dependencies       String?

  // Hierarchical Relationship (Parent-Child)
  parentId String?
  parent   Asset?  @relation("AssetHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Asset[] @relation("AssetHierarchy")

  // IP Management
  ipAllocations IPAllocation[]

  createdByUserId String
  createdByUser   User   @relation(fields: [createdByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patchInfo   PatchInfo?
  credentials Credential[]
  notes       AssetNote[]
  attachments AssetAttachment[]

  @@index([status])
  @@index([type])
  @@index([environment])
  @@index([owner])
}

model PatchInfo {
  id      String @id @default(uuid())
  assetId String @unique
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  currentVersion  String?
  latestVersion   String?
  eolDate         DateTime?
  lastPatchedDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Credential {
  id           String         @id @default(uuid())
  assetId      String
  asset        Asset          @relation(fields: [assetId], references: [id], onDelete: Cascade)
  accessPoints IPAllocation[]

  username          String
  encryptedPassword String
  type              String? // e.g. 'IPMI', 'OS', 'SSH', 'WEB'
  nodeLabel         String?
  manageType        String? // e.g. WEB, SSH, API
  version           String? // e.g. iLO 2.81, ESXi 8.0.3

  lastChangedDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assetId])
}

model AuditLog {
  id     String  @id @default(uuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  action    AuditAction
  targetId  String? // ID of the asset or credential interacted with
  ipAddress String?
  details   String? // Optional JSON or text details

  timestamp DateTime @default(now())

  @@index([userId])
  @@index([timestamp])
  @@index([action])
  @@index([targetId])
}

model DatabaseInventory {
  id                String          @id @default(uuid())
  name              String
  engine            String
  version           String?
  environment       String?
  host              String
  ipAddress         String
  port              String?
  serviceName       String?
  owner             String?
  backupPolicy      String?
  replication       String?
  linkedApps        String[]
  maintenanceWindow String?
  status            DatabaseStatus? @default(ACTIVE)
  note              String?
  responsibleParty  String?
  hostAssetId       String?
  hostAsset         Asset?          @relation("DatabaseHostAsset", fields: [hostAssetId], references: [id], onDelete: SetNull)
  hostVmId          String?
  hostVm            VmInventory?    @relation("DatabaseHostVm", fields: [hostVmId], references: [id], onDelete: SetNull)

  createdByUserId String
  createdByUser   User   @relation(fields: [createdByUserId], references: [id])

  accounts         DatabaseAccount[]
  logicalDatabases LogicalDatabase[]
  documentLinks    KnowledgeDocumentDatabase[]
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt

  @@index([status])
  @@index([engine])
  @@index([environment])
  @@index([hostAssetId])
  @@index([hostVmId])
}

model ApplicationComponentAsset {
  id               String               @id @default(uuid())
  componentId      String
  component        ApplicationComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)
  assetId          String
  asset            Asset                @relation(fields: [assetId], references: [id], onDelete: Cascade)
  relationType     String               @default("PRIMARY")
  responsibleParty String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@unique([componentId, assetId])
  @@index([assetId])
}

model ApplicationComponentVm {
  id               String               @id @default(uuid())
  componentId      String
  component        ApplicationComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)
  vmId             String
  vm               VmInventory          @relation(fields: [vmId], references: [id], onDelete: Cascade)
  relationType     String               @default("PRIMARY")
  responsibleParty String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@unique([componentId, vmId])
  @@index([vmId])
}

model DatabaseAccount {
  id                  String            @id @default(uuid())
  databaseInventoryId String
  databaseInventory   DatabaseInventory @relation(fields: [databaseInventoryId], references: [id], onDelete: Cascade)

  username          String
  role              String?
  encryptedPassword String
  privileges        String[]
  note              String?
  scope             String            @default("INSTANCE")
  logicalDatabases  LogicalDatabase[] @relation("DatabaseAccountScopes")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LogicalDatabase {
  id                  String                 @id @default(uuid())
  databaseInventoryId String
  databaseInventory   DatabaseInventory      @relation(fields: [databaseInventoryId], references: [id], onDelete: Cascade)
  name                String
  description         String?
  components          ApplicationComponent[]
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  accounts            DatabaseAccount[]      @relation("DatabaseAccountScopes")

  @@unique([databaseInventoryId, name])
  @@index([databaseInventoryId])
}

model VmVCenterSource {
  id                String         @id @default(uuid())
  name              String         @unique
  endpoint          String
  version           String
  username          String?
  encryptedPassword String?
  syncInterval      Int
  status            VmSourceStatus @default(READY_TO_SYNC)
  lastSyncAt        DateTime?
  notes             String?

  createdByUserId String?
  createdByUser   User?   @relation(fields: [createdByUserId], references: [id])

  discoveries VmDiscovery[]
  inventories VmInventory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VmDiscovery {
  id                   String           @id @default(uuid())
  name                 String
  systemName           String?
  moid                 String
  sourceId             String
  source               VmVCenterSource  @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  cluster              String
  clusterResolution    String           @default("UNKNOWN")
  host                 String
  hostResolution       String           @default("UNKNOWN")
  computerName         String?
  guestOs              String
  primaryIp            String
  cpuCores             Int
  memoryGb             Int
  storageGb            Int
  disks                Json?
  networkLabel         String
  powerState           VmPowerState
  state                VmDiscoveryState
  completeness         Int
  missingFields        String[]
  lastSeenAt           DateTime
  tags                 String[]
  guestAccountsCount   Int              @default(0)
  owner                String?
  environment          VmEnvironment?
  businessUnit         String?
  slaTier              String?
  serviceRole          String?
  criticality          VmCriticality?
  description          String?
  notes                String?
  suggestedOwner       String?
  suggestedEnvironment VmEnvironment?
  suggestedServiceRole String?
  suggestedCriticality VmCriticality?

  createdByUserId String?
  createdByUser   User?   @relation(fields: [createdByUserId], references: [id])

  guestAccounts VmGuestAccount[]
  inventory     VmInventory?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sourceId, moid])
  @@index([state])
}

model VmInventory {
  id                String           @id @default(uuid())
  discoveryId       String?          @unique
  discovery         VmDiscovery?     @relation(fields: [discoveryId], references: [id], onDelete: SetNull)
  sourceId          String?
  source            VmVCenterSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  name              String
  systemName        String
  moid              String
  environment       VmEnvironment?
  cluster           String
  clusterResolution String           @default("UNKNOWN")
  host              String
  hostResolution    String           @default("UNKNOWN")
  computerName      String?
  guestOs           String
  primaryIp         String
  cpuCores          Int
  memoryGb          Int
  storageGb         Int
  disks             Json?
  networkLabel      String
  powerState        VmPowerState
  lifecycleState    VmLifecycleState
  discoveryState    VmDiscoveryState @default(NEEDS_CONTEXT)
  responsibleParty  String?
  syncState         String
  owner             String
  businessUnit      String
  slaTier           String
  serviceRole       String
  criticality       VmCriticality
  description       String
  tags              String[]
  lastSyncAt        DateTime
  syncedFields      String[]
  managedFields     String[]
  notes             String

  createdByUserId String?
  createdByUser   User?   @relation(fields: [createdByUserId], references: [id])

  guestAccounts   VmGuestAccount[]
  componentLinks  ApplicationComponentVm[]
  hostedDatabases DatabaseInventory[]      @relation("DatabaseHostVm")
  documentLinks   KnowledgeDocumentVm[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sourceId, moid])
  @@index([lifecycleState])
  @@index([environment])
  @@index([owner])
}

model VmGuestAccount {
  id                String       @id @default(uuid())
  username          String
  encryptedPassword String
  accessMethod      String
  role              String
  note              String?
  discoveryId       String?
  discovery         VmDiscovery? @relation(fields: [discoveryId], references: [id], onDelete: SetNull)
  inventoryId       String?
  inventory         VmInventory? @relation(fields: [inventoryId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AssetNote {
  id      String @id @default(uuid())
  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  content  String // Note content (markdown-friendly)
  isPinned Boolean @default(false)

  createdByUserId String
  createdByUser   User   @relation(fields: [createdByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AssetAttachment {
  id      String @id @default(uuid())
  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  filename   String // display filename e.g. "rack-photo.jpg"
  storedPath String // relative path e.g. "uploads/assets/uuid.jpg"
  mimeType   String // e.g. "image/jpeg"
  sizeBytes  Int

  createdByUserId String
  createdByUser   User   @relation(fields: [createdByUserId], references: [id])

  createdAt DateTime @default(now())
}

model KnowledgeCategory {
  id        String              @id @default(uuid())
  name      String              @unique
  icon      String?
  documents KnowledgeDocument[]
}

model KnowledgeDocument {
  id               String                         @id @default(uuid())
  title            String
  content          String
  categoryId       String
  category         KnowledgeCategory              @relation(fields: [categoryId], references: [id])
  authorId         String
  author           User                           @relation(fields: [authorId], references: [id])
  applicationLinks KnowledgeDocumentApplication[]
  assetLinks       KnowledgeDocumentAsset[]
  vmLinks          KnowledgeDocumentVm[]
  databaseLinks    KnowledgeDocumentDatabase[]
  viewCount        Int                            @default(0)
  createdAt        DateTime                       @default(now())
  updatedAt        DateTime                       @updatedAt

  @@index([categoryId])
}

model KnowledgeDocumentApplication {
  documentId    String
  document      KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  applicationId String
  application   Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@id([documentId, applicationId])
  @@index([applicationId])
}

model KnowledgeDocumentAsset {
  documentId String
  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  assetId    String
  asset      Asset             @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([documentId, assetId])
  @@index([assetId])
}

model KnowledgeDocumentVm {
  documentId String
  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  vmId       String
  vm         VmInventory       @relation(fields: [vmId], references: [id], onDelete: Cascade)

  @@id([documentId, vmId])
  @@index([vmId])
}

model KnowledgeDocumentDatabase {
  documentId String
  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  databaseId String
  database   DatabaseInventory @relation(fields: [databaseId], references: [id], onDelete: Cascade)

  @@id([documentId, databaseId])
  @@index([databaseId])
}

model TokenBlocklist {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
}
